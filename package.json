{
  "name": "atelier",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -F @atelier/blog dev",
    "build": "pnpm -r build",
    "start": "pnpm -F @atelier/blog start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "docker:blog:build": "docker build -f apps/blog/Dockerfile -t atelier-blog:test .",
    "docker:blog:blue:up": "docker compose up --build -d blog-blue",
    "docker:blog:green:up": "docker compose up --build -d blog-green",
    "docker:blog:down": "docker compose down",
    "docker:registry:up": "docker compose up -d registry",
    "docker:proxy:up": "docker compose up --build -d blog-blue blog-green nginx",
    "docker:proxy:down": "docker compose down",
    "jenkins:up": "docker compose -f docker-compose.jenkins.yml up --build -d",
    "jenkins:down": "docker compose -f docker-compose.jenkins.yml down",
    "deploy:blog:local": "powershell -ExecutionPolicy Bypass -File scripts/deploy-blog-local.ps1"
  }
}
